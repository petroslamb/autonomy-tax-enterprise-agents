.DS_Store

# Ignore local MAST acquisition artifacts and curated raw bundle.
/sources/raw/mast/

# Ignore all PDFs by default to keep history clean
*.pdf

# Ignore generated video renders and channel-side operational metadata
/artifacts/video/*.mp4
/artifacts/video/shorts/landscape/*.mp4
/artifacts/video/shorts/portrait/*.mp4
/artifacts/video/**/*upload_report*.json
/artifacts/video/**/upload_manifest.json
/artifacts/video/**/shorts_manifest.json
/artifacts/video/**/cinematic_shorts_manifest.json

# Whitelist: PDFs with NO full-text conversion (Abstract only)
# Verified by format audit 2026-04-20
!sources/raw/073*.pdf
!sources/raw/074*.pdf
!sources/raw/075*.pdf
!sources/raw/076*.pdf
!sources/raw/077*.pdf
!sources/raw/078*.pdf
!sources/raw/079*.pdf
!sources/raw/080*.pdf
!sources/raw/081*.pdf
